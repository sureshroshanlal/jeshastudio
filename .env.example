# ==============================================================================
# JESHA STUDIO - SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Obtain these credentials from your Supabase Dashboard:
# 1. Go to https://supabase.com/dashboard/project/_/settings/api
# 2. Copy the Project URL and Anon Key into .env.local

# Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Public Anon Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Service Role Secret Key (for elevated backend admin tasks)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
